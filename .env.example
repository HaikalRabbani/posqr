# POS F&B QR (customer mobile SPA) — copy to .env and set values.
# Only VITE_* vars apply; baked into the static bundle at build time.

# Backend API (include the /api/v1 suffix).
VITE_API_BASE_URL=https://api.etres.my.id/api/v1

# Reverb / WebSocket. Must match backend REVERB_APP_KEY.
# SCHEME drives TLS: https -> wss (PORT 443), http -> ws (raw IP, e.g. PORT 9011).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
